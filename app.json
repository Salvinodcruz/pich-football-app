{
  "expo": {
    "name": "pich",
    "slug": "pich",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pich",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.salvino.pich",
      "supportsTablet": true,
      "buildNumber": "1",
      "privacyPolicyUrl": "https://www.pich.ae/privacy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pich uses your location to show nearby football venues and matches."
      }
    },
    "android": {
      "package": "com.salvino.pich",
      "versionCode": 1,
      "privacyPolicyUrl": "https://www.pich.ae/privacy",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3787355d-3e3c-4db5-8fff-f7b5c5bcc361"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3787355d-3e3c-4db5-8fff-f7b5c5bcc361"
    }
  }
}
